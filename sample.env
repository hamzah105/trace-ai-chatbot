MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=trace_ai

OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=300

# Optional Google OAuth. Local register/login remains available when blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=change-this-local-dev-secret


# Stage 8: optional external OOMP memory. Off preserves the original TRACE path.
TRACE_OOMP_MODE=off
TRACE_OOMP_URL=http://127.0.0.1:8765/mcp
TRACE_OOMP_TRACE_ORIGIN=http://127.0.0.1:8000
TRACE_OOMP_OWNER_ID=
TRACE_OOMP_TENANT_ID=trace-local
TRACE_OOMP_NAMESPACE=personal
TRACE_OOMP_PRINCIPAL_ID=trace-host
TRACE_OOMP_SOURCE_SYSTEM=trace-ai
TRACE_OOMP_READ_TOKEN=
TRACE_OOMP_OWNER_KEY=
TRACE_OOMP_TIMEOUT_SECONDS=5
TRACE_OOMP_EVIDENCE_BUDGET=1200
TRACE_OOMP_MAX_RESULTS=5
TRACE_OOMP_RETRIEVAL_MODE=lexical
TRACE_OOMP_ALLOW_DEGRADED=false
TRACE_OOMP_NUM_CTX=8192
TRACE_OOMP_MAX_PROMPT_BYTES=7000
TRACE_OOMP_GENERATION_RESERVE=512

# Only for explicitly approved retrieve_and_ingest deployments.
# Copy the non-secret templates into ignored credentials/, then set private values.
TRACE_OOMP_WRITER_CONFIG=credentials/oomp-writers.local.json
TRACE_OOMP_USER_TOKEN=
TRACE_OOMP_USER_APPROVAL_KEY=
TRACE_OOMP_ASSISTANT_TOKEN=
TRACE_OOMP_ASSISTANT_APPROVAL_KEY=
